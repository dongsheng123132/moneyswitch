{
  "name": "moneyswitch-connect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lib": {
      "types": "./dist/lib/cli.d.ts",
      "default": "./dist/lib/cli.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    }
  },
  "bin": {
    "moneyswitch-connect": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run test/unit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@moneyswitch/mcp": "workspace:*",
    "@moneyswitch/net": "workspace:*"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "tsx": "4.23.15",
    "vitest": "5.0.2",
    "@types/node": "22.10.5"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongsheng123132/moneyswitch.git",
    "directory": "apps/connect"
  }
}
