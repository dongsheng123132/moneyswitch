MONEYSWITCH_IMAGE=moneyswitch:local
MONEYSWITCH_LOCAL_PORT=4020
MONEYSWITCH_PUBLIC_URL=https://app.moneyswitch.dev
# For release-directory deployments, set an absolute path outside the release.
# MONEYSWITCH_WALLET_PASSWORD_PATH=/opt/moneyswitch/secrets/wallet_password
# Testnets by default. Explicitly selecting mainnet permits REAL USDC spending. Both kinds can be listed together: every key is then issued as a testnet key or a mainnet key.
MONEYSWITCH_NETWORKS=eip155:10143,eip155:84532
MONEYSWITCH_DEFAULT_NETWORK=eip155:10143
# Mainnet example: eip155:143,eip155:8453. Balances are separate on each chain.
